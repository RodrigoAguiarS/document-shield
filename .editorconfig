root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[backend/src/{main,test}/java/**/*.java]
indent_style = space
indent_size = 4
continuation_indent_size = 4
max_line_length = 120

[backend/pom.xml]
indent_style = space
indent_size = 4

[*.{md,yml,yaml,json,sql}]
trim_trailing_whitespace = false
